/* ═══════════════════════════════════════════════════════════════════════════
   FomoCCS Admin TUI — global stylesheet (Textual CSS v2)
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Base ────────────────────────────────────────────────────────────────── */

Screen {
    background: $surface;
    color: $text;
}

Header {
    background: $panel-darken-1;
    color: $text;
    text-style: bold;
    dock: top;
    height: 1;
}

Footer {
    background: $panel-darken-1;
    dock: bottom;
    height: 1;
    color: $text-muted;
}

/* ── Breadcrumb ─────────────────────────────────────────────────────────── */

#screen-title {
    dock: top;
    height: 1;
    background: $primary-darken-1 80%;
    color: $text;
    text-style: bold;
    content-align: center middle;
    padding: 0 2;
    width: 100%;
    border-bottom: solid $primary;
}

#breadcrumb {
    dock: top;
    height: 1;
    background: $primary 8%;
    color: $primary-lighten-1;
    text-style: bold;
    padding: 0 2;
    border-bottom: solid $primary 30%;
}

/* ── Navigation tabs ───────────────────────────────────────────────────── */

#nav-tabs {
    dock: top;
    height: 1;
    background: $panel-darken-1;
    border-bottom: solid $primary-darken-1 60%;
}

#nav-tabs Button {
    min-width: 13;
    max-width: 18;
    margin: 0;
    border: none;
    border-bottom: tall transparent;
    background: transparent;
    color: $text-muted;
    content-align: center middle;
    text-style: none;
}

#nav-tabs Button:hover {
    background: $primary 12%;
    color: $text;
    border-bottom: tall $primary 40%;
}

#nav-tabs Button.-active {
    background: $primary 18%;
    color: $primary-lighten-1;
    text-style: bold;
    border-bottom: tall $primary;
}


/* ── Dashboard grid ─────────────────────────────────────────────────────── */

#dashboard-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: auto;
    padding: 1 2;
}

#dashboard-grid Static {
    height: auto;
    min-height: 5;
    content-align: left top;
    padding: 0;
    margin: 0;
}

#health { border-left: thick $success; }
#crawls { border-left: thick $warning; }
#events-stats { border-left: thick $success; }
#sources { border-left: thick $primary; }
#llm { border-left: thick $accent; }
#recent-events { border-left: thick $secondary; }

#last-crawls {
    height: auto;
    min-height: 3;
    padding: 0;
    margin: 0 2 1 2;
    border-left: thick $primary;
}

#dash-spinner {
    height: 1;
    padding: 0 2;
    margin-bottom: 1;
}


/* ── Filter bar ─────────────────────────────────────────────────────────── */

#filters {
    height: auto;
    min-height: 3;
    padding: 1 2;
    background: $panel;
    border-bottom: solid $primary 25%;
}

#filters Input {
    width: 30;
    margin-right: 2;
    height: auto;
    min-height: 1;
    border: solid $accent;
}

#filters Input:focus {
    border: solid $accent;
    background: $surface;
}

#filters Label {
    padding: 0 2;
    color: $text-muted;
    content-align: center middle;
    height: auto;
    min-height: 1;
}

#counter {
    color: $text-muted;
    text-align: right;
    width: auto;
}


/* ── DataTables ─────────────────────────────────────────────────────────── */

DataTable {
    height: 1fr;
    border: solid $panel;
    background: $surface;
}

DataTable > .datatable--header {
    background: $primary 10%;
    color: $primary-lighten-1;
    text-style: bold;
    height: 1;
}

DataTable > .datatable--cursor {
    background: $primary 12%;
    color: $text;
    border-left: thick $accent;
}

DataTable > .datatable--fixed {
    background: $surface;
}

DataTable > .datatable--odd-row {
    background: $panel 30%;
}

DataTable > .datatable--even-row {
    background: $surface;
}

DataTable:focus > .datatable--cursor {
    border-left: thick $accent;
}


/* ── Loading / Empty states ─────────────────────────────────────────────── */

LoadingIndicator {
    height: auto;
    padding: 1 2;
    color: $text-muted;
    content-align: center middle;
}

#empty-state {
    height: auto;
    padding: 3 2;
    content-align: center middle;
    color: $text-muted;
    border: dashed $panel;
    margin: 2 4;
}


/* ── Status badges ──────────────────────────────────────────────────────── */

StatusBadge {
    width: auto;
    height: 1;
    padding: 0 2;
    content-align: center middle;
    text-style: bold;
}


/* ── Detail containers ──────────────────────────────────────────────────── */

#source-detail,
#event-detail,
#location-detail {
    padding: 1 2;
    overflow-y: auto;
    height: 1fr;
}

#source-detail Static,
#event-detail Static,
#location-detail Static {
    padding: 1 0;
}

#source-name,
#event-name,
#loc-name {
    padding: 1 0;
    text-style: bold;
}

#source-meta,
#event-meta,
#loc-meta {
    height: auto;
    min-height: 3;
}

#detail-spinner {
    padding: 1 2;
}

.detail-section {
    padding: 1 0;
    margin-top: 1;
    border-top: solid $panel;
}


/* ── Source wizard ──────────────────────────────────────────────────────── */

#wizard-form {
    padding: 1 2;
    overflow-y: auto;
    height: 1fr;
}

#wizard-form Label {
    margin-top: 1;
    color: $text-muted;
}

#wizard-form Input {
    width: 50;
    margin-bottom: 1;
}

#wizard-form Select {
    width: 50;
    margin-bottom: 1;
}

#url-row {
    height: auto;
    align: left middle;
}

#url-row Input {
    width: 50;
    margin-right: 2;
    margin-bottom: 0;
}

#ig-label,
#ig-max-label {
    margin-top: 1;
    color: $text-muted;
}

#sw-ig-username,
#sw-ig-max-posts {
    width: 30;
    margin-bottom: 1;
}

#wizard-actions {
    margin-top: 2;
    height: auto;
    align: left middle;
}

#wizard-actions Button {
    margin-right: 2;
}

#wizard-actions .btn-destructive {
    border: solid $error;
    color: $error;
}

#sw-status {
    margin-top: 1;
    color: $text;
    height: 1;
}


/* ── Pipeline run screen ────────────────────────────────────────────────── */

#pipeline-container {
    padding: 1;
}

#pipeline-cmd {
    color: $text-muted;
    padding-bottom: 1;
}

#pipeline-status {
    height: 1;
    padding: 0 2;
    text-style: bold;
}

#pipeline-progress {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#pipeline-output {
    height: 1fr;
    overflow-y: auto;
    border: solid $panel;
    padding: 1;
}


/* ── Operations ─────────────────────────────────────────────────────────── */

#operations-container {
    padding: 1 2;
}

.ops-section {
    border-bottom: solid $accent 40%;
    color: $accent;
    text-style: bold;
    padding: 1 0;
    margin-top: 1;
}

.ops-button-row {
    height: auto;
    align: left middle;
    padding: 0 0 1 0;
}

.ops-button-row Button {
    margin: 0 1;
    width: auto;
    min-width: 20;
}

.ops-button-row Button:disabled {
    border: solid #555555;
    color: #8b949e;
    background: $panel-darken-1;
}

/* ── Buttons (global) ─────────────────────────────────────────────────── */

Button {
    border: solid $primary 50%;
}

Button:hover {
    border: solid $accent;
    background: $accent 12%;
}

Button:focus {
    border: solid $accent;
    text-style: bold;
}


#ops-status {
    height: 1;
    color: $text-muted;
    padding: 1 0;
}

#ops-output {
    height: 1fr;
    overflow-y: auto;
    border: solid $panel;
    padding: 1;
    min-height: 5;
    background: $surface;
}


/* ── Logs ───────────────────────────────────────────────────────────────── */

#logs-content {
    height: 1fr;
    overflow-y: auto;
    padding: 1;
}

#logs-title {
    padding: 1;
    text-style: bold;
}

#logs-spinner {
    padding: 1;
}


/* ── Dialogs ────────────────────────────────────────────────────────────── */

ConfirmDialog {
    align: center middle;
}

ConfirmDialog > Vertical {
    width: 54;
    height: auto;
    padding: 2 3;
    border: thick $accent;
    background: $surface;
}

ConfirmDialog > Vertical > Static {
    padding: 1 0;
    width: 100%;
}

ConfirmDialog > Vertical > Horizontal {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1;
}

ConfirmDialog > Vertical > Horizontal Button {
    margin: 0 1;
    min-width: 10;
}

InputDialog {
    align: center middle;
}

InputDialog > Vertical {
    width: 54;
    height: auto;
    padding: 2 3;
    border: thick $accent;
    background: $surface;
}

InputDialog > Vertical > Static {
    padding: 1 0;
    width: 100%;
}

InputDialog > Vertical > Input {
    margin-top: 1;
    width: 100%;
}

InputDialog > Vertical > Horizontal {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1;
}

InputDialog > Vertical > Horizontal Button {
    margin: 0 1;
    min-width: 10;
}


/* ── Help modal ────────────────────────────────────────────────────────── */

#help-container {
    padding: 1 2;
    height: auto;
    min-height: 10;
    border: thick $accent;
    background: $surface;
    margin: 2 4;
}

#help-container Static {
    padding: 1 0;
    content-align: left top;
}


/* ── Notifications ─────────────────────────────────────────────────────── */

Notification {
    border: solid $accent;
}


/* ── Progress bar ──────────────────────────────────────────────────────── */

ProgressBar {
    width: 100%;
    height: 1;
}

ProgressBar > .bar--bar {
    background: $primary;
}

ProgressBar > .bar--complete {
    background: $success;
}


/* ── Transitions / Animations ──────────────────────────────────────────── */

Screen {
    hatch: none;
}
